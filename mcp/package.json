{
  "name": "pakistan-mutual-funds-mcp",
  "version": "0.3.0",
  "description": "MCP server for Pakistani mutual fund NAVs, history, and returns — zero-setup, reads the free public MUFAP-sourced dataset. Runs locally over stdio or hosted on Cloudflare Workers.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pakistan-mutual-funds-mcp": "index.js"
  },
  "files": [
    "index.js",
    "server.js",
    "README.md"
  ],
  "scripts": {
    "test": "node test-client.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:remote": "node test-remote.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pakistan",
    "mutual-funds",
    "nav",
    "mufap",
    "fintech"
  ],
  "author": "Saad Salman (https://saadsalman.org)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saadsalmankhan/pakistan-mutual-funds-api.git",
    "directory": "mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
