# Port the API server listens on
PORT=4000

# How many times per day the built-in scheduler scrapes MUFAP. MUFAP only
# publishes updated NAVs once per business day, so 1 is the sensible
# default — raising this just makes more requests against their site for
# no new data. Set to 0 to disable the built-in scheduler entirely (e.g.
# if you'd rather trigger `npm run scrape` from your own cron/GitHub
# Actions/Vercel Cron instead).
FETCH_TIMES_PER_DAY=1

# Skip scheduled fetches on Sat/Sun (MUFAP doesn't publish on weekends).
# Set to false to fetch every day regardless.
SKIP_WEEKENDS=true

# Where scraped data is stored on disk.
DATA_FILE=./data/funds.json
